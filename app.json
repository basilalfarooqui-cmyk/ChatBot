{
  "expo": {
    "name": "SIH Chatbot",
    "slug": "sih-chatbot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sihchatbot",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sih26088.chatbot"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.sih26088.chatbot",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-asset",
      "expo-audio"
    ]
  }
}
